# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the app (OAuth callbacks, self-referential links).
# Production: https://vibefit.fidadev.ir
APP_URL="http://localhost:3000"

# PORT: HTTP port for the Node server (default 3000).
PORT=3000

# DATA_DIR: Persistent user data directory (workout routines, sessions, chat)
DATA_DIR="./data"

# Exercise catalog: bundled free DB at catalog/free_exercises_catalog_v1.json
# (yuhonas/free-exercise-db, Unlicense) — no MuscleWiki API key needed
