# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the app (OAuth callbacks, self-referential links).
# Production: https://vibefit.fidadev.ir
APP_URL="http://localhost:3000"

# PORT: HTTP port for the Node server (default 3000).
PORT=3000

# MUSCLEWIKI_API_KEY: MuscleWiki API key (TESTING plan or higher — BASIC/playground keys are rejected outside their site)
MUSCLEWIKI_API_KEY="mw_your_key_here"

# DATA_DIR: Persistent user data directory (workout routines, sessions, chat)
DATA_DIR="./data"
